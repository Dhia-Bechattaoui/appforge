# AppForge Showcase Environment Configuration (.env)
# Zero-dependency, RFC-compliant, with variable interpolation and secret masking

APP_NAME="AppForge Studio"
APP_ENV=production
APP_VERSION=1.3.0

# Network & API Endpoint Configuration (interpolating variables)
API_HOST=api.appforge.dev
API_PORT=443
API_BASE_URL=https://${API_HOST}:${API_PORT}/v1
API_TIMEOUT_SEC=15

# Feature Flags
FEATURE_ANALYTICS=true
FEATURE_BETA_UI=false

# Sensitive Keys (automatically masked in logs and debug summaries)
API_SECRET_KEY="forge_sec_9948201849182049182"
DATABASE_PASSWORD="secretPass123"
